{
  "name": "@neonbyte/tui",
  "version": "1.0.0",
  "exports": {
    ".": "./mod.ts",
    "./reactive": "./reactive/mod.ts",
    "./reactive/components": "./reactive/components/mod.ts",
    "./reactive/jsx-runtime": "./reactive/jsx-runtime.ts"
  },
  "publish": {
    "exclude": [".github/", "test/", "tools/", "examples/"]
  },
  "imports": {
    "marked": "npm:marked@^18",
    "@std/assert": "jsr:@std/assert@1",
    "@std/testing": "jsr:@std/testing@1"
  },
  "tasks": {
    "tui:demo": "deno run examples/chat.ts",
    "tui:editor": "deno run examples/editor.ts",
    "tui:progress": "deno run examples/progress.ts",
    "tui:tasks": "deno run examples/tasks.ts",
    "tui:widgets": "deno run examples/widgets.tsx",
    "docs:check": "deno run --allow-read --allow-run tools/check_docs.ts",
    "test": "deno test --doc"
  },
  "lint": {
    "plugins": ["./tools/lint/style.ts"],
    "rules": {
      "tags": ["recommended", "jsr"]
    },
    "exclude": ["node_modules/"]
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@neonbyte/tui/reactive"
  },
  "fmt": {
    "sortNamedImports": "maintain"
  }
}
